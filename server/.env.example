# CivicFix Server Environment Configuration Example
# Copy this file to .env and supply actual credentials for local development.

PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/civicfix?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Image Upload Service Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Semantic Embedding & Duplicate Detection Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
LEXICAL_TEXT_WEIGHT=0.35
SEMANTIC_TEXT_WEIGHT=0.65
DUPLICATE_RADIUS_METERS=500
DUPLICATE_MAX_CANDIDATES=5
