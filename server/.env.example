# CivicFix Server Environment Configuration Example
# Copy this file to .env and supply actual credentials for local development.

PORT=5000
NODE_ENV=production

# Frontend Client Origin URL for CORS (e.g. https://your-civicfix-client.vercel.app or comma-separated list or *)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/smartcity?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Image Upload Service Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Citizen OTP Authentication Configuration
OTP_PROVIDER=console
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5

# Demo Authentication Configuration (Disabled by default; set to true to enable Demo Citizen bypass)
DEMO_AUTH_ENABLED=false

# Semantic Embedding & Duplicate Detection Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
LEXICAL_TEXT_WEIGHT=0.35
SEMANTIC_TEXT_WEIGHT=0.65
DUPLICATE_RADIUS_METERS=500
DUPLICATE_MAX_CANDIDATES=5
