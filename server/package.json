{
  "name": "civicfix-server",
  "version": "1.0.0",
  "description": "CivicFix Backend API Server — Multi-Department AI Civic Issue Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node seed.js",
    "test": "node tests/security/accessControl.test.js",
    "test:all": "node tests/runAllTests.js",
    "test:unit": "node tests/unit/classification.test.js && node tests/unit/duplicateDetection.test.js && node tests/unit/semanticDuplicates.test.js",
    "test:integration": "node tests/integration/complaintLifecycle.test.js && node tests/integration/departmentAuthorization.test.js && node tests/integration/analyticsOverview.test.js && node tests/integration/analyticsHotspots.test.js",
    "test:security": "node tests/security/securityBoundary.test.js && node tests/security/accessControl.test.js"
  },
  "keywords": [
    "civicfix",
